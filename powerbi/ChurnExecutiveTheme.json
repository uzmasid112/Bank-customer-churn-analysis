{
  "name": "Churn Executive",
  "dataColors": [
    "#1B2A41",
    "#D9622B",
    "#8C96A8",
    "#2F6B8A",
    "#7A9CB8",
    "#E8A07A",
    "#4B5563",
    "#C9D1DC"
  ],
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#6B7280",
  "foregroundNeutralTertiary": "#9CA3AF",
  "background": "#FFFFFF",
  "backgroundLight": "#F7F8FA",
  "backgroundNeutral": "#E3E7ED",
  "tableAccent": "#1B2A41",
  "good": "#2E7D5B",
  "neutral": "#B7791F",
  "bad": "#D9622B",
  "maximum": "#D9622B",
  "center": "#F2B694",
  "minimum": "#FCEFE8",
  "null": "#F3F4F6",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F2937"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2937"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 12,
      "color": "#4B5563"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#1B2A41"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 15,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": true,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 12,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 90
          }
        ],
        "padding": [
          {
            "top": 14,
            "bottom": 12,
            "left": 18,
            "right": 18
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "transparency": 0,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "border": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 13,
            "color": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "labelPosition": "OutsideEnd"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#4B5563"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontSize": 30,
            "fontColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "label": [
          {
            "$id": "default",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "textSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 14,
            "right": 14
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "bold": false
          }
        ],
        "values": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F8FA"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "gridVertical": false,
            "rowPadding": 4
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13
          }
        ],
        "values": [
          {
            "fontSize": 13,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "rowPadding": 10
          }
        ],
        "columnTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "bold": true
          }
        ],
        "rowTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "bold": true
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#F1F3F6"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#E3E7ED"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#1B2A41"
              }
            }
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "shape": [
          {
            "rectangleRoundedCurve": 8
          }
        ],
        "layout": [
          {
            "cellPadding": 8
          }
        ]
      }
    }
  }
}